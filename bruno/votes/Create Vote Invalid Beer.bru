meta {
  name: Create Vote Invalid Beer
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/votes
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "user_id": "{{userId}}",
    "beer_id": 99
  }
}

tests {
  test("status is 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
}

docs {
  Negative case: beer_id outside 1..10 → 400.
  Needs a valid `userId` in the environment (Create User first).
  If the user already voted, you may get 409 instead — create a fresh user first.
}
