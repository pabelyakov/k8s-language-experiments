meta {
  name: Health Check
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/health
  body: none
  auth: none
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("service is beer-vote", function () {
    expect(res.getBody().service).to.equal("beer-vote");
  });

  test("status is ok", function () {
    expect(res.getBody().status).to.equal("ok");
  });
}

docs {
  Liveness/readiness probe. Response includes `runtime` (java-spring, go, nodejs-nestjs, ...).
}
