meta {
  name: List Users By Name Asc
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/v1/users
  body: none
  auth: none
}

params:query {
  page: 1
  page_size: 50
  sort: name
  order: asc
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Sort by `name` ascending with a larger page size.
}
